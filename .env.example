# ==============================================================================
# MMM Analytics Bot — Environment Variables Configuration Template
# ==============================================================================
# Nusxa oling va nomini .env qilib saqlang:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT SOZLAMALARI
# ------------------------------------------------------------------------------
# Telegram Bot Token (@BotFather orqali yaratiladi)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_example

# Bot administratori Telegram ID raqamlari (vergul bilan ajratiladi)
# O'z ID raqamingizni bilish uchun Telegramda @userinfobot ga /start bosing
ADMIN_IDS=6656667725

# Ruxsat berilgan Telegram guruh ID lari (bo'sh qoldirilsa, bot qo'shilgan barcha guruhlardan ma'lumot oladi)
# Masalan: -1001234567890
ALLOWED_GROUP_IDS=

# Guruhda xabar saqlanganda javob yozish (false = jim rejim, bot guruhda ortiqcha xabar yozmaydi)
NOTIFY_IN_GROUP=false

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI API (Matnni tahlil qilish uchun)
# ------------------------------------------------------------------------------
# Google AI Studio orqali olinadi: https://aistudio.google.com/app/apikey (Bepul)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. TURSO CLOUD MA'LUMOTLAR BAZASI (Bulutli libSQL / SQLite)
# ------------------------------------------------------------------------------
# Bepul Turso hisobi: https://turso.tech (9GB xotira, oyiga 1 milliard so'rov bepul)
# Bo'sh qoldirilsa, bot avtomatik ravishda lokal warehouse.db faylidan foydalanadi.
TURSO_DATABASE_URL=libsql://mmm-analytics-yourorg.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_jwt_token_here

# Lokal SQLite fayli manzili (faqat lokal offline rejimda ishlatiladi)
DB_PATH=warehouse.db

# ------------------------------------------------------------------------------
# 4. SERVER VA TELEGRAM MINI APP SOZLAMALARI
# ------------------------------------------------------------------------------
# Server porti (Koyeb, Render yoki Docker $PORT o'zgaruvchisini avtomatik uzatadi)
PORT=8000

# Telegram Mini App URL manzili (Koyeb yoki Cloudflare domeni)
# Masalan: https://mmm-analytics-yourname.koyeb.app
WEB_APP_URL=https://mmm-analytics.koyeb.app

# Bot ishlash rejimi: 'polling' (bepul Koyeb uchun standart) yoki 'webhook' (serverless uchun)
BOT_MODE=polling

# Webhook xavfsizlik maxfiy kaliti (faqat BOT_MODE=webhook bo'lganda talab qilinadi)
WEBHOOK_SECRET=mmm_super_secret_token_change_in_production

# Muhit: 'production' yoki 'development'
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 5. QO'SHIMCHA SOZLAMALAR
# ------------------------------------------------------------------------------
# Lokal Windows muhitida Cloudflare tunnelni avtomatik yoqish (bulutda shart emas: false)
AUTO_TUNNEL=false

# Chiquvchi proksi (agar server provayderingiz Telegram API ga to'g'ridan-to'g'ri ulana olmasa)
# Masalan: socks5://user:pass@host:port yoki http://host:port
PROXY_URL=
